[Unit]
Description=PZ Monitor Service
After=network.target

[Service]
Type=forking
User=ubuntu
WorkingDirectory=/home/ubuntu/pz_server_manager
ExecStart=/home/ubuntu/pz_server_manager/start-monitor.sh
ExecStop=/home/ubuntu/pz_server_manager/stop-monitor.sh
Restart=on-failure
RestartSec=5s
PIDFile=/home/ubuntu/pz_server_manager/back/pidfile_monitor

[Install]
WantedBy=multi-user.target
